<?xml version="1.0"?>
<package format="3">
  <name>ros2_camera_info_bridge</name>
  <version>0.1.0</version>
  <description>Publishes Android camera intrinsics as sensor_msgs/CameraInfo.</description>
  <maintainer email="maintainer@example.com">android-camera-app</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-requests</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
