{
  "command-safety-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/safety_guard.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
